SERVER_ENV=development
LOG_LEVEL=debug
SERVER_PORT=8080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=manager
DB_USER=manager
DB_PASSWORD=manager
DB_PARAMS=parseTime=true&loc=UTC&charset=utf8mb4

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=/absolute/path/to/serviceAccountKey.json

# Legacy variables used by docker-compose defaults
APP_ENV=development
PORT=8080
